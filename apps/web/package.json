{
  "name": "@commonsops/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "build": "next build && node --test lib/production-accessibility.test.mjs",
    "test": "node --test lib/*.test.ts lib/live/*.test.ts src/components/*.test.ts src/features/**/*.test.ts",
